# Copy to .env.local and fill in. Never commit .env.local.

# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where "Let's talk" enquiries are delivered (your inbox).
CONTACT_TO_EMAIL=you@example.com

# Sender. Without a verified domain, keep onboarding@resend.dev:
# it can only deliver to the email you signed up to Resend with.
# After verifying a domain in Resend, use e.g. NiaBezz <hello@yourdomain.dev>
CONTACT_FROM_EMAIL=NiaBezz <onboarding@resend.dev>
